{
  "name": "apikana",
  "version": "0.11.4",
  "description": "Integrated tools for REST API design - ｱﾋﾟ",
  "exports": "./index.js",
  "type": "module",
  "bin": {
    "apikana": "./bin/apikana",
    "apikana-serve": "./bin/apikana-serve"
  },
  "scripts": {
    "build": "browserify src/browserify.js -t brfs -i source-map-support > lib/browserify.js",
    "test": "node --no-deprecation test/runner.js",
    "test-build": "cd test && node ../bin/apikana start --javaPackage=apikana.test --log=info",
    "test-deploy": "cd test && node ../bin/apikana start --javaPackage=apikana.test --deploy",
    "test-serve": "cd test && node ../bin/apikana-serve --port=8222",
    "prepublishOnly": "crlf --set=LF bin/*"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/swisspost/apikana.git"
  },
  "release": {
    "branches": [
      "master",
      {
        "name": "develop",
        "channel": "next"
      }
    ],
    "plugins": [
      "@semantic-release/commit-analyzer",
      "@semantic-release/npm",
      "@semantic-release/git"
    ]
  },
  "keywords": [
    "REST",
    "API",
    "design",
    "openapi",
    "swagger",
    "typescript",
    "documentation",
    "contract-first"
  ],
  "author": "Laurent Bovet",
  "contributors": [
    "Stefan Niederhauser",
    "Mattia Amato",
    "Manuel Ruwe"
  ],
  "license": "Apache-2.0",
  "bugs": {
    "url": "https://github.com/swisspost/apikana/issues"
  },
  "homepage": "https://github.com/swisspost/apikana#readme",
  "engines": {
    "node": "^22.14.0 || >= 24.10.0",
    "npm": ">= 8.19.2"
  },
  "dependencies": {
    "ajv": "8.17.1",
    "ansi-colors": "4.1.3",
    "compare-versions": "6.1.1",
    "fs-extra": "11.3.2",
    "gulp": "5.0.1",
    "gulp-inject": "5.0.5",
    "gulp-json-editor": "2.6.0",
    "gulp-rename": "2.1.0",
    "gulp-replace": "1.1.4",
    "json-schema-faker": "^0.5.9",
    "json-schema-migrate": "^2.0.0",
    "live-plugin-manager": "1.1.0",
    "merge-stream": "2.0.0",
    "node-http-server": "8.1.6",
    "object-path": "0.11.8",
    "open": "^11.0.0",
    "plop": "4.0.4",
    "registry-url": "7.2.0",
    "slash": "^5.1.0",
    "string-to-stream": "3.0.1",
    "swagger-ui": "5.30.3",
    "through2": "4.0.2",
    "time-stamp": "2.2.0",
    "traverse": "0.6.11",
    "typescript": "5.9.3",
    "typescript-to-json-schema": "0.6.1",
    "typescript-to-json-schema-extra": "0.2.1",
    "validatorjs": "3.22.1",
    "vinyl-buffer": "1.0.1",
    "vinyl-source-stream": "2.0.0",
    "winston": "3.18.3",
    "yamljs": "0.3.0"
  },
  "devDependencies": {
    "@semantic-release/git": "^10.0.1",
    "@semantic-release/npm": "^13.1.2",
    "brfs": "2.0.2",
    "browserify": "17.0.1",
    "crlf": "1.1.1",
    "docson": "2.1.0",
    "jasmine": "5.12.0",
    "java-parser": "3.0.1",
    "semantic-release": "^25.0.2",
    "shonkwrap": "^1.3.0"
  },
  "overrides": {
    "graceful-fs": "^4.2.11"
  }
}
